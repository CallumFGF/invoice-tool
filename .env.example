# Required — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/
# Authorised redirect URI: https://your-app.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel Postgres (Neon) — added automatically when you link a DB in Vercel dashboard
# For local dev: paste the connection string from Vercel Storage → your DB → .env.local tab
POSTGRES_URL=
